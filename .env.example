# ==============================================================================
# Environment Configuration Template for Student Placement MLOps
# Copy this file to '.env' for local custom overrides (do NOT commit .env)
# ==============================================================================

# Server Network Settings
PORT=8000
HOST=127.0.0.1
DEBUG=false
ENVIRONMENT=development

# Model & Pipeline Configuration
CURRENT_MODEL_VERSION=v1.2.1
PLACEMENT_THRESHOLD=0.50
RANDOM_SEED=42

# Logging & Observability
LOG_LEVEL=INFO
ENABLE_DRIFT_DETECTION=true
